# Server
HOST=0.0.0.0
PORT=1337

# Database (matches docker-compose.yml's postgres service)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=korzu_cms
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_SSL=false

# Secrets — generate your own, never reuse these across projects or commit real values.
# APP_KEYS needs 4 comma-separated values; the rest are single values.
# Generate each with: node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
ENCRYPTION_KEY=
