# Full node-linker=hoisted would collapse react/@types/react to one version across every app —
# breaks web (React 19) + mobile (React 18) coexisting in the same monorepo. Instead, hoist only
# the React Native/Expo/Metro packages that need a flat, non-symlinked layout for autolinking
# and Jest/Metro's node_modules scanning to work; every app keeps its own React version.
public-hoist-pattern[]=*react-native*
public-hoist-pattern[]=*@expo*
public-hoist-pattern[]=expo
public-hoist-pattern[]=expo-*
public-hoist-pattern[]=@react-navigation/*

# pnpm's own internal hoist (hoist-pattern, default "*") flattens every dependency — including
# @types/react — into node_modules/.pnpm/node_modules/. That's an ancestor directory of every
# package physically stored under .pnpm/, so any .d.ts file resolving a bare "react" import
# (without that package as its own direct dependency) finds this ambiguous slot instead. Web
# (React 19) and mobile (React 18) need different versions; pnpm can only hoist one into the
# shared slot, silently leaking it into the other app's typecheck. Exclude just the React type
# packages — every app already gets the correct version via its own dependency graph, so nothing
# legitimate depends on the hoisted copy. (metro-cache is NOT excluded here even though the same
# ambiguity exists for it — @expo/metro-config resolves it as an undeclared phantom dependency
# and only finds it via this shared hoisted slot; apps/mobile pins its own "metro-cache" version
# as a direct dependency in package.json specifically so pnpm hoists THAT version into the slot.)
hoist-pattern[]=*
hoist-pattern[]=!@types/react
hoist-pattern[]=!@types/react-dom
