{
  "name": "create-korzu-app",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Scaffold a Next.js/MUI frontend, NestJS backend, Expo mobile app, and/or Strapi CMS — standalone or as a Turborepo monorepo.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomikorzu/korzu-dev-setup.git"
  },
  "bugs": {
    "url": "https://github.com/tomikorzu/korzu-dev-setup/issues"
  },
  "homepage": "https://github.com/tomikorzu/korzu-dev-setup#readme",
  "keywords": [
    "cli",
    "scaffold",
    "create-app",
    "nextjs",
    "nestjs",
    "expo",
    "strapi",
    "turborepo"
  ],
  "bin": {
    "create-korzu-app": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{ts,json}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "templates/web/**/*.{ts,tsx,json,css}": [
      "biome check --write --no-errors-on-unmatched --config-path=templates/web/biome.json"
    ],
    "templates/api/**/*.{ts,json}": [
      "biome check --write --no-errors-on-unmatched --config-path=templates/api/biome.json"
    ],
    "templates/mobile/**/*.{ts,tsx,json}": [
      "biome check --write --no-errors-on-unmatched --config-path=templates/mobile/biome.json"
    ],
    "templates/cms/**/*.{ts,tsx,json}": [
      "biome check --write --no-errors-on-unmatched --config-path=templates/cms/biome.json"
    ]
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "picocolors": "^1.1.1",
    "validate-npm-package-name": "^6.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@types/node": "^22.20.3",
    "@types/validate-npm-package-name": "^4.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
